{
    "configurations": [
        {
            "type": "cmake",
            "request": "launch",
            "name": "Debug portfile(s)",
            "cmakeDebugType": "external",
            "pipeName": "/tmp/vcpkg_ext_portfile_dbg",
            "preLaunchTask": "Debug vcpkg commands"
        },
        {
            "name": "Demo: Andalusian (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/line_based_recons",
            "args": [
                "-i",
                "data/Andalusian/input_lines_from_residuals.json",
                "-o",
                "result/demo-Andalusian/",
                "-cp",
                "1",
                "-cv",
                "1",
                "-ca",
                "0",
                "-ce",
                "0.1",
                "-cc",
                "0.1",
                "-ext",
                "-v"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "MOSEK_DIR",
                    "value": "${workspaceFolder}/../../third_/mosek"
                },
                {
                    "name": "MOSEKLM_LICENSE_FILE",
                    "value": "${workspaceFolder}/../../third_/mosek/mosek.lic"
                },
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/../../third_/mosek/8/tools/platform/linux64x86/bin:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build demo (Debug)"
        },
